# 认证中心（SSO）地址：由 Vite 在构建时注入（VITE_ 前缀才会暴露给客户端）
#
# 使用方法：
#   cp .env.example .env
#   把下面的占位地址替换为你的真实认证中心地址
#
# 真实地址只存在于本地 .env（已被 .gitignore 忽略），源码与仓库中不含任何私有地址。
# 未配置时前端回退到占位符 https://auth.example.com/auth。
VITE_AUTH_CENTER_URL=https://auth.example.com/auth

# Hermes 控制台地址（Admin 侧栏「Hermes」页的 iframe 指向它）
# 真实值只写在本地 .env（已 gitignore），仓库只保留占位
VITE_HERMES_DASHBOARD_URL=https://hermes.example.com
